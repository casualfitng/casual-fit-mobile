{
  "expo": {
    "name": "Casual Fit",
    "slug": "casual-fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon_light.png",
    "scheme": "casualfit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/app_icon_light.png",
        "dark": "./assets/images/app_icon_dark.png"
      },
      "supportsTablet": true,
      "bundleIdentifier": "com.casualfit.app",
      "appleTeamId": "DD8TNQ2A9A",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Casual Fit uses the camera so you can take a profile picture.",
        "NSPhotoLibraryUsageDescription": "Casual Fit uses your photo library so you can choose a profile picture.",
        "NSMicrophoneUsageDescription": "Casual Fit may use the microphone when recording video with the camera.",
        "NSLocalNetworkUsageDescription": "Casual Fit connects to the workout API on your Wi-Fi during development.",
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "EXExpoAppSceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0D0F",
        "foregroundImage": "./assets/images/app_icon_light.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/first_light.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/first_dark.png",
            "backgroundColor": "#000000"
          },
          "android": {
            "image": "./assets/images/first_light.png",
            "imageWidth": 280,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF",
            "dark": {
              "image": "./assets/images/first_dark.png",
              "backgroundColor": "#000000"
            }
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Casual Fit uses your photo library so you can choose a profile picture.",
          "cameraPermission": "Casual Fit uses the camera so you can take a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
